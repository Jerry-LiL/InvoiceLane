DATABASE_URL=postgres://invoicelane:invoicelane@localhost:5432/invoicelane

# Sign the session cookie. Use a long random string in any shared environment.
SESSION_SECRET=replace-with-a-long-random-string

# Bearer token for /api/cron/reminders. The reminder script does not need it.
CRON_SECRET=replace-with-another-long-random-string

# Calendar dates for "due" and "overdue" are evaluated in this timezone.
APP_TIMEZONE=UTC

# console prints messages. smtp delivers them (Mailpit listens on 1025).
EMAIL_MODE=console
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
SMTP_FROM="InvoiceLane <billing@localhost>"

# How often the sweep may email the same invoice, and when it stops.
REMINDER_COOLDOWN_DAYS=3
REMINDER_MAX_COUNT=4

# Local demo account created by npm run db:seed.
SEED_PASSWORD=invoicelane-demo
